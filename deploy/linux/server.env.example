# shorebird-server configuration for the native Linux install
# (deploy/linux/install.sh, docs/SELF_UPDATE.md). Environment only.
# The installer creates the secrets below when missing and never replaces an
# existing value. Back this file up with the database: PATCH_SIGNING_MASTER_KEY
# wraps the managed patch signing keys stored there.

# --- Server ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
# Public URL devices and the CLI use (https behind a reverse proxy; install.sh --domain sets up Caddy).
SERVER_BASE_URL=http://localhost:8080

# --- Database (set by the installer; never switched on a rerun) ---
# postgres: the local PostgreSQL over its Unix socket with peer authentication
# (no password), or an external DATABASE_URL (--database-url). The server
# applies its schema migrations at startup (DB_AUTO_MIGRATE=off disables).
# sqlite: only with --sqlite (small or test installs), file DB_PATH.
DB_DRIVER=postgres
DATABASE_URL=
DB_PATH=@STATE_DIR@/data/shorebird.db

# --- Storage: local (default) or s3 ---
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=@STATE_DIR@/data/storage
# STORAGE_S3_ENDPOINT=, STORAGE_S3_ACCESS_KEY=, STORAGE_S3_SECRET_KEY=, ...

# --- Secrets (generated by the installer when missing) ---
JWT_SECRET=
PATCH_SIGNING_MASTER_KEY=

# --- Bootstrap administrator (password change required at first login) ---
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_PASSWORD=
DEFAULT_ADMIN_NAME=Administrator

# --- Optional: account e-mail (links are logged when SMTP_HOST is empty) ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=shorebird@example.com

# --- Optional: per-device patch encryption (rerun the installer to create its secret) ---
# PATCH_DELIVERY_ENCRYPTION=per_device_aes_gcm

# --- Self-update (docs/SELF_UPDATE.md). Settings: <bin dir>/server-update.json ---
# SERVER_SELF_UPDATE=auto
# SERVER_UPDATE_MIRROR_URL=default
# SERVER_UPDATE_GITHUB_TOKEN=
